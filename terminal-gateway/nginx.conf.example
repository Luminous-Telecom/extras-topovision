# Web do Zabbix server — uma location para todos os slugs.
# map: console.map.conf no http {}. $1 = slug, $2 = resto (/terminal/open, /health).

location ~ ^/console/([A-Za-z0-9._-]+)(/.*)$ {
    resolver 127.0.0.53 127.0.0.1 ipv6=off valid=30s;
    proxy_pass http://$topovision_console_pass$2$is_args$args;
    proxy_http_version 1.1;
    proxy_read_timeout 60s;
    proxy_set_header Authorization $http_authorization;
}
