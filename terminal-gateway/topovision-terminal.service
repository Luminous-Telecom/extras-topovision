[Unit]
Description=TopoVision terminal gateway (SSH/Telnet)
After=network.target

[Service]
Type=simple
EnvironmentFile=-/etc/topovision-terminal.env
ExecStart=/usr/local/bin/gpx_topology_linux_amd64 terminal
Restart=on-failure
RestartSec=2
# Só localhost: o nginx da web do Zabbix é quem recebe o tráfego externo.
# Sem TOPOVISION_TERMINAL_TOKEN no env, qualquer processo nesta máquina abre sessão.

[Install]
WantedBy=multi-user.target
