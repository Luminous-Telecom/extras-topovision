# Recorte para a web do Zabbix server. Proxy remoto: um location /console/{slug}/
# com proxy_pass no IP:9100 do proxy (não 127.0.0.1 do server).
location /console/ {
    proxy_pass http://127.0.0.1:9100/;
    proxy_http_version 1.1;
    proxy_read_timeout 60s;
    proxy_set_header Authorization $http_authorization;
}
